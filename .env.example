# ---------- 服务 ----------
PORT=3000
# 默认只监听本机；真机联调改成 0.0.0.0 时，必须同时修改 JWT_SECRET 和后台密码
HOST=127.0.0.1
# 生产环境必须换成随机长字符串（至少 32 位），不要提交到 Git
JWT_SECRET=dev-only-change-me-please-32-chars
JWT_USER_TTL=7d
JWT_ADMIN_TTL=12h

# ---------- 数据库 ----------
# 相对 server/ 目录
DB_PATH=data/app.db

# ---------- 微信小程序 ----------
# 本地联调建议 true：不请求微信服务器，用 mock code 直接登录
WECHAT_MOCK=true
WECHAT_APPID=
WECHAT_SECRET=

# ---------- 大模型（OpenAI 兼容接口）----------
# 留空则自动使用规则兜底，不会报错；配置后 /analytics/interpret 会真实调用
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000

# ---------- 初始化账号 ----------
# 首次执行 npm run seed 时使用；上线前务必修改
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=Operator@123

# ---------- 分析 ----------
# 展示与按天聚合时使用的时区偏移（中国 +8）
ANALYTICS_TZ_OFFSET=8
