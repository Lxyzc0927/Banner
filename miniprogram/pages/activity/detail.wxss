.hero { height: 360rpx; }
.hero-title { font-size: 48rpx; font-weight: 700; letter-spacing: 4rpx; }
.hero-sub { font-size: 24rpx; opacity: .8; margin-top: 14rpx; }

.title { font-size: 36rpx; font-weight: 700; margin-bottom: 16rpx; }
.info { display: flex; font-size: 26rpx; padding: 10rpx 0; }
.label { width: 150rpx; flex-shrink: 0; color: #999; }
.mt { margin-top: 16rpx; }
.desc { font-size: 26rpx; line-height: 1.8; color: #555; }

.sheet-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.field { display: flex; align-items: center; min-height: 96rpx; border-bottom: 2rpx solid #f0f1f3; }
.field-label { width: 140rpx; flex-shrink: 0; color: #666; }
.field-input { flex: 1; font-size: 28rpx; }
.field-value { flex: 1; font-size: 28rpx; }
.phone-btn { margin: 0; background: #fdeee7; color: #e8541e; font-size: 24rpx; border-radius: 30rpx; }
.sheet-tip { font-size: 22rpx; color: #999; margin: 20rpx 0 30rpx; }
