<view class="tabs">
  <view wx:for="{{tabs}}" wx:key="value" class="tab {{status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onTab">{{item.label}}</view>
</view>

<view class="list">
  <view wx:for="{{list}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">
    <view class="card-cover placeholder">
      <text class="cover-title">{{item.title}}</text>
    </view>
    <view class="card-body">
      <view class="row">
        <text class="title">{{item.title}}</text>
        <text class="tag {{item.stateClass}}">{{item.stateText}}</text>
      </view>
      <view class="meta">🕒 {{item.date}}</view>
      <view class="meta">📍 {{item.place}}</view>
      <view class="quota">
        <view class="progress grow"><view class="progress-fill" style="width: {{item.percent}}%"></view></view>
        <text class="quota-text">{{item.signup}}/{{item.quota}} 人</text>
      </view>
    </view>
  </view>
</view>

<empty wx:if="{{empty && !loading && !error}}" text="暂无相关活动" />

<view class="list-foot">
  <text wx:if="{{loading}}">加载中…</text>
  <text wx:elif="{{error}}" bindtap="onRetry">加载失败，点击重试</text>
  <text wx:elif="{{finished && !empty}}">没有更多了</text>
</view>
