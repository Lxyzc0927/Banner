<view class="chat">
  <scroll-view class="msgs" scroll-y scroll-into-view="{{intoView}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view wx:for="{{messages}}" wx:key="id" id="m{{item.id}}" class="msg {{item.role}}">
      <view class="bubble {{item.pending ? 'pending' : ''}} {{item.failed ? 'failed' : ''}}">
        <text user-select>{{item.content}}</text>
      </view>
      <view wx:if="{{item.bikes.length}}" class="recs">
        <view wx:for="{{item.bikes}}" wx:for-item="b" wx:key="id" class="rec" hover-class="pressed" data-id="{{b.id}}" bindtap="openBike">
          <plate wx:if="{{b.cc}}" cc="{{b.cc || 0}}" size="m" />
          <text class="rec-name">{{b.name}}</text>
          <text class="rec-price"><text class="yen">¥</text><text class="num">{{b.priceText}}</text></text>
          <image class="icon-s" src="/assets/icons/caret-right-bold-5a5a57.svg" aria-hidden="true" />
        </view>
      </view>
      <view wx:if="{{item.failed}}" class="retry" data-id="{{item.id}}" data-text="{{item.retry}}" bindtap="onRetry">重新发送</view>
    </view>
    <view class="msgs-bottom"></view>
  </scroll-view>

  <scroll-view class="quick" scroll-x enable-flex show-scrollbar="{{false}}">
    <view wx:for="{{quick}}" wx:key="*this" class="quick-item" hover-class="pressed" data-text="{{item}}" bindtap="onQuick">{{item}}</view>
  </scroll-view>

  <view class="bar safe">
    <input class="input" value="{{input}}" placeholder="问车型、价格或活动" placeholder-class="ph" confirm-type="send" maxlength="200" cursor-spacing="20" bindinput="onInput" bindconfirm="onSend" />
    <button class="send" disabled="{{!input || sending}}" bindtap="onSend" aria-label="发送">
      <image class="icon" src="/assets/icons/paper-plane-right-fill-ffffff.svg" aria-hidden="true" />
    </button>
  </view>
</view>
