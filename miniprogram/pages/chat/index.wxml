<view class="chat">
  <scroll-view class="msgs" scroll-y scroll-into-view="{{intoView}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view wx:for="{{messages}}" wx:key="id" id="m{{item.id}}" class="row {{item.role}}">
      <view class="avatar">{{item.role === 'user' ? '我' : '客服'}}</view>
      <view class="body">
        <view class="bubble {{item.pending ? 'pending' : ''}}">
          <text user-select>{{item.content}}</text>
        </view>
        <view wx:if="{{item.bikes.length}}" class="recs">
          <view wx:for="{{item.bikes}}" wx:for-item="b" wx:key="id" class="rec" data-id="{{b.id}}" bindtap="openBike">
            <text class="rec-name">{{b.name}}</text>
            <text class="rec-price">¥{{b.priceText}} ›</text>
          </view>
        </view>
        <view wx:if="{{item.failed}}" class="retry" data-id="{{item.id}}" data-text="{{item.retry}}" bindtap="onRetry">点击重试</view>
      </view>
    </view>
    <view class="msgs-bottom"></view>
  </scroll-view>

  <scroll-view class="quick" scroll-x enable-flex>
    <view wx:for="{{quick}}" wx:key="*this" class="quick-item" data-text="{{item}}" bindtap="onQuick">{{item}}</view>
  </scroll-view>

  <view class="bar safe">
    <input class="input" value="{{input}}" placeholder="问问车型、价格、活动…" confirm-type="send" maxlength="200" cursor-spacing="20" bindinput="onInput" bindconfirm="onSend" />
    <button class="send" size="mini" disabled="{{!input || sending}}" bindtap="onSend">发送</button>
  </view>
</view>
