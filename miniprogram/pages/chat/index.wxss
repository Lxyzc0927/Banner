.chat { height: 100vh; display: flex; flex-direction: column; }
.msgs { flex: 1; height: 0; padding: 20rpx 0; }
.msgs-bottom { height: 20rpx; }

.row { display: flex; align-items: flex-start; padding: 14rpx 24rpx; }
.row.user { flex-direction: row-reverse; }
.avatar { width: 72rpx; height: 72rpx; line-height: 72rpx; flex-shrink: 0; text-align: center; border-radius: 50%; font-size: 22rpx; background: #1f2430; color: #fff; }
.row.user .avatar { background: #e8541e; }
.body { max-width: 72%; margin: 0 18rpx; display: flex; flex-direction: column; }
.row.user .body { align-items: flex-end; }

.bubble { padding: 20rpx 24rpx; border-radius: 8rpx 24rpx 24rpx 24rpx; background: #fff; font-size: 28rpx; line-height: 1.6; word-break: break-all; }
.row.user .bubble { border-radius: 24rpx 8rpx 24rpx 24rpx; background: #e8541e; color: #fff; }
.bubble.pending { color: #999; }

.recs { margin-top: 12rpx; background: #fff; border-radius: 16rpx; overflow: hidden; }
.rec { display: flex; justify-content: space-between; padding: 20rpx 24rpx; border-bottom: 2rpx solid #f0f1f3; font-size: 26rpx; }
.rec:last-child { border-bottom: none; }
.rec-name { font-weight: 600; }
.rec-price { color: #e8541e; margin-left: 20rpx; }
.retry { margin-top: 10rpx; font-size: 24rpx; color: #e8541e; }

.quick { display: flex; white-space: nowrap; padding: 12rpx 24rpx; }
.quick-item { display: inline-block; flex-shrink: 0; padding: 10rpx 24rpx; margin-right: 16rpx; border-radius: 30rpx; background: #fff; border: 2rpx solid #f0d6cb; color: #e8541e; font-size: 24rpx; }

.bar { display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff; }
.input { flex: 1; height: 72rpx; padding: 0 24rpx; border-radius: 36rpx; background: #f5f6f8; font-size: 28rpx; }
.send { margin: 0 0 0 16rpx; background: #e8541e; color: #fff; border-radius: 36rpx; font-size: 26rpx; line-height: 72rpx; height: 72rpx; padding: 0 30rpx; }
.send[disabled] { background: #f0b9a4 !important; color: #fff !important; }
