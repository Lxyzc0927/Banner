.page { padding-bottom: 30rpx; }
.banner { height: 340rpx; }
.banner-img { width: 100%; height: 100%; }
.banner-title { font-size: 44rpx; font-weight: 700; letter-spacing: 4rpx; }
.banner-sub { font-size: 24rpx; margin-top: 16rpx; opacity: .8; }

.entries { display: flex; background: #fff; margin: -30rpx 24rpx 0; position: relative; z-index: 2; border-radius: 16rpx; padding: 28rpx 0; box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, .06); }
.entry { flex: 1; display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: #555; }
.entry-icon { width: 84rpx; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 50%; background: #fdeee7; color: #e8541e; font-size: 40rpx; margin-bottom: 10rpx; }

.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.grid-item { display: block; border: 2rpx solid #f0f1f3; border-radius: 16rpx; overflow: hidden; }

.news { padding: 22rpx 0; border-bottom: 2rpx solid #f0f1f3; }
.news:last-child { border-bottom: none; }
.news-title { font-size: 28rpx; }
.news-date { font-size: 22rpx; color: #999; margin-top: 8rpx; }

.chat-entry { display: flex; justify-content: space-between; align-items: center; margin: 20rpx 24rpx; padding: 30rpx; border-radius: 16rpx; background: #1f2430; color: #fff; }
.chat-title { font-size: 30rpx; font-weight: 600; }
.chat-sub { font-size: 22rpx; opacity: .7; margin-top: 8rpx; }
.chat-btn { padding: 12rpx 28rpx; border-radius: 30rpx; background: #e8541e; font-size: 24rpx; }
