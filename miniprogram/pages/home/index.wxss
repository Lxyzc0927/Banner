.top { padding-top: 16rpx; }
.search { display: flex; align-items: center; gap: 16rpx; height: 88rpx; padding: 0 28rpx; border-radius: 16rpx; background: var(--paper-2); font-size: 28rpx; color: var(--ink-2); }
.search.pressed { background: #ebebe8; }

.banner { height: 300rpx; margin-top: 24rpx; }
.count { font-size: 32rpx; color: var(--ink); }
.board {
  position: relative; height: 252rpx; margin: 0 32rpx; padding: 28rpx 32rpx 28rpx 36rpx;
  box-sizing: border-box; overflow: hidden;
  background: var(--yellow); border: 6rpx solid var(--ink); border-radius: 32rpx;
  display: flex; align-items: stretch; gap: 16rpx;
  transition: transform 120ms ease-out;
}
.board.pressed { transform: translateY(4rpx); }
/* 车型 Banner 按排量档位着色，活动 Banner 固定黄牌 */
.board-white { background: var(--paper); }
.board-red { background: var(--red); border-color: var(--red); color: var(--paper); }
.board-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.board-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.board-title { font-size: 44rpx; font-weight: 800; line-height: 1.2; letter-spacing: -1rpx; }
.board-line { font-size: 26rpx; margin-top: 8rpx; }
.board-go { display: flex; align-items: center; gap: 4rpx; margin-top: auto; min-height: 44rpx; font-size: 28rpx; font-weight: 600; }
.board-num { display: flex; align-items: flex-end; flex-shrink: 0; }
.board-num .big { font-size: 176rpx; line-height: .78; }
.board-num .unit { font-size: 30rpx; font-weight: 700; margin-left: 6rpx; }

.entries { display: flex; margin: 16rpx 32rpx 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.entry { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 28rpx 0; font-size: 26rpx; }
.entry + .entry { border-left: 1px solid var(--line); }
.entry.pressed { background: var(--paper-2); }

.chat-entry { display: flex; align-items: center; gap: 24rpx; margin: 48rpx 32rpx 0; padding: 36rpx 32rpx; border-radius: 24rpx; background: var(--ink); color: var(--paper); }
.chat-entry.pressed { background: #2b2b29; }
.chat-text { flex: 1; }
.chat-title { font-size: 34rpx; font-weight: 700; }
.chat-sub { font-size: 26rpx; color: #c4c4c0; margin-top: 8rpx; }
.chat-btn { flex-shrink: 0; height: 88rpx; line-height: 88rpx; padding: 0 28rpx; border-radius: 12rpx; background: var(--paper); color: var(--ink); font-size: 28rpx; font-weight: 700; }

.news { display: flex; justify-content: space-between; align-items: baseline; gap: 24rpx; padding: 28rpx 0; border-bottom: 1px solid var(--line); }
.news.pressed { background: var(--paper-2); }
.news-title { flex: 1; font-size: 30rpx; }
.news-date { font-size: 28rpx; color: var(--ink-2); flex-shrink: 0; }
.end { height: 48rpx; }

.sk-search { height: 88rpx; margin-top: 16rpx; }
.sk-banner { height: 252rpx; margin-top: 24rpx; border-radius: 32rpx; }
.sk-row { height: 112rpx; margin-top: 32rpx; }
