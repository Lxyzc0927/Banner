.gallery { height: 480rpx; }
.gallery-img { width: 100%; height: 100%; }

.head { padding-top: 24rpx; }
.name { font-size: 48rpx; font-weight: 800; letter-spacing: -1rpx; margin-top: 32rpx; }
.price-row { display: flex; align-items: baseline; gap: 16rpx; margin-top: 16rpx; }
.price { font-size: 64rpx; line-height: 1; }
.yen { font-size: 32rpx; font-weight: 700; margin-right: 4rpx; }
.price-tip { font-size: 26rpx; color: var(--ink-2); }
.labels { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 28rpx; }
.label { display: flex; align-items: center; gap: 8rpx; height: 88rpx; padding: 0 16rpx 0 24rpx; border: 2rpx solid var(--ink); border-radius: 16rpx; box-sizing: border-box; font-size: 28rpx; transition: transform 120ms ease-out; }
.label.pressed { transform: translateY(4rpx); background: var(--paper-2); }
.swatch { width: 24rpx; height: 24rpx; border: 3rpx solid var(--ink); border-radius: 6rpx; box-sizing: border-box; }
.swatch.plate-red { border-color: var(--red); }
.icon-xs { width: 24rpx; height: 24rpx; }

.specs { border-top: 2rpx solid var(--ink); }
.spec { display: flex; align-items: baseline; padding: 24rpx 0; border-bottom: 1px solid var(--line); }
.spec-label { flex: 1; font-size: 30rpx; color: var(--ink-2); }
.spec-value { font-size: 44rpx; text-align: right; }
.spec-unit { width: 72rpx; margin-left: 10rpx; font-size: 26rpx; color: var(--ink-2); }

.desc { display: block; font-size: 30rpx; line-height: 1.8; color: #2b2b29; }

.fav { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 104rpx; height: 96rpx; font-size: 22rpx; border-radius: 12rpx; }
.fav.pressed { background: var(--paper-2); }
button.grow { flex: 1; padding: 0 20rpx; }

.sk-hero { height: 360rpx; margin-top: 24rpx; border-radius: 40rpx; }
.sk-line { height: 56rpx; margin-top: 32rpx; }
.sk-line.short { width: 50%; }
