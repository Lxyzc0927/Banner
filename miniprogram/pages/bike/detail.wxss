.hero { height: 460rpx; }
.hero-img { width: 100%; height: 100%; }
.hero-cat { font-size: 28rpx; letter-spacing: 8rpx; opacity: .8; }
.hero-name { font-size: 52rpx; font-weight: 700; margin-top: 12rpx; }

.name { font-size: 36rpx; font-weight: 700; }
.price { font-size: 40rpx; color: #e8541e; font-weight: 700; margin-top: 12rpx; }
.price-tip { font-size: 22rpx; color: #999; font-weight: 400; margin-left: 12rpx; }
.tags { margin-top: 18rpx; }

.params { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28rpx 0; }
.param { display: flex; flex-direction: column; align-items: center; }
.param-value { font-size: 30rpx; font-weight: 600; }
.param-label { font-size: 22rpx; color: #999; margin-top: 6rpx; }

.desc { font-size: 26rpx; line-height: 1.8; color: #555; }

.fav { display: flex; flex-direction: column; align-items: center; width: 100rpx; font-size: 20rpx; color: #666; }
.fav-icon { font-size: 40rpx; line-height: 1.1; }
.fav.on { color: #e8541e; }
button.grow { flex: 1; }
