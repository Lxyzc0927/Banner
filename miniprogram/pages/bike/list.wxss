.toolbar { position: sticky; top: 0; z-index: 5; background: var(--paper); padding: 16rpx 32rpx 20rpx; border-bottom: 1px solid var(--line); }
.search { display: flex; align-items: center; gap: 16rpx; height: 88rpx; padding: 0 8rpx 0 28rpx; border-radius: 16rpx; background: var(--paper-2); }
.search-input { flex: 1; height: 88rpx; font-size: 30rpx; }
.ph { color: var(--ink-2); }
.search-clear { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; }
.chips { display: flex; white-space: nowrap; margin-top: 20rpx; height: 96rpx; }
.chip {
  display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
  height: 88rpx; margin-right: 16rpx; border-radius: 16rpx; font-size: 28rpx;
  transition: transform 120ms ease-out;
}
.chip.pressed { transform: translateY(4rpx); }
.chip-all { padding: 0 28rpx; border: 2rpx solid var(--ink); background: var(--paper); font-weight: 600; }
.chip-all.on { background: var(--ink); color: var(--paper); }
/* 排量芯片是小号码牌：未选时白底细边，选中时显示档位颜色并加粗描边 */
.chip-plate { min-width: 120rpx; padding: 0 20rpx; border: 2rpx solid var(--ink); background: var(--paper); font-size: 36rpx; }
.chip-plate.on { border-width: 6rpx; }
.chip-yellow { background: var(--yellow); }
.chip-red { background: var(--red); color: var(--paper); border-color: var(--red); }

/* 排序与价格：分段控件 + 价格按钮，选中都用黑底 */
.sortbar { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.segments { flex: 1; display: flex; height: 88rpx; padding: 6rpx; border-radius: 16rpx; background: var(--paper-2); box-sizing: border-box; }
.seg { flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; font-size: 26rpx; color: var(--ink-2); }
.seg.on { background: var(--ink); color: var(--paper); font-weight: 700; }
.filter-btn { display: flex; align-items: center; gap: 6rpx; height: 88rpx; padding: 0 18rpx 0 22rpx; border: 2rpx solid var(--ink); border-radius: 16rpx; box-sizing: border-box; font-size: 26rpx; font-weight: 600; flex-shrink: 0; transition: transform 120ms ease-out; }
.filter-btn.on { background: var(--ink); color: var(--paper); }
.filter-btn.pressed { transform: translateY(4rpx); }
.badge { min-width: 32rpx; height: 32rpx; line-height: 32rpx; padding: 0 6rpx; border-radius: 16rpx; background: var(--paper); color: var(--ink); font-size: 24rpx; text-align: center; box-sizing: border-box; }

/* 已选条件：黑底小签，点一下去掉 */
.pills { display: flex; white-space: nowrap; margin-top: 16rpx; height: 88rpx; }
.pill { display: inline-flex; align-items: center; gap: 8rpx; flex-shrink: 0; height: 88rpx; padding: 0 20rpx 0 26rpx; margin-right: 12rpx; border-radius: 44rpx; background: var(--ink); color: var(--paper); font-size: 26rpx; box-sizing: border-box; }
.pill.pressed { background: #2b2b29; }
.pill-clear { display: inline-flex; align-items: center; flex-shrink: 0; height: 88rpx; padding: 0 16rpx; font-size: 26rpx; color: var(--ink-2); text-decoration: underline; }

.sheet-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.sheet-title { font-size: 36rpx; font-weight: 700; }
.close { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin-right: -24rpx; }
.presets { display: flex; flex-wrap: wrap; gap: 16rpx; }
.preset { display: flex; align-items: center; justify-content: center; height: 88rpx; padding: 0 28rpx; border: 2rpx solid var(--ink); border-radius: 16rpx; font-size: 28rpx; box-sizing: border-box; }
.preset.on { background: var(--ink); color: var(--paper); font-weight: 700; }
.preset.pressed { background: var(--paper-2); }
.preset.on.pressed { background: #2b2b29; }
.custom-label { font-size: 26rpx; font-weight: 600; margin: 40rpx 0 12rpx; }
.custom { display: flex; align-items: center; gap: 16rpx; }
.price-input { flex: 1; height: 96rpx; padding: 0 24rpx; border: 2rpx solid var(--line); border-radius: 16rpx; font-size: 36rpx; }
.price-input.invalid { border-color: var(--red); }
.dash { width: 24rpx; height: 4rpx; background: var(--ink); flex-shrink: 0; }
.field-error { display: block; margin-top: 12rpx; font-size: 26rpx; color: var(--red); }
button.confirm { margin-top: 40rpx; }

.tag-sheet { display: flex; flex-direction: column; max-height: 80vh; }
.tag-body { flex: 1; max-height: 56vh; }
.group-label { font-size: 26rpx; font-weight: 600; margin: 28rpx 0 12rpx; }
.group-label:first-child { margin-top: 8rpx; }
.group-hint { margin-left: 12rpx; font-weight: 400; color: var(--ink-2); }
/* 档位选中时显示对应号码牌颜色 */
.tier-opt.on.tier-entry { background: var(--paper); color: var(--ink); border-width: 6rpx; }
.tier-opt.on.tier-mid { background: var(--yellow); color: var(--ink); border-width: 6rpx; }
.tier-opt.on.tier-big { background: var(--red); color: var(--paper); border-color: var(--red); }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
button.reset { width: 200rpx; flex-shrink: 0; }
button.grow { flex: 1; }

.sk-row { height: 112rpx; margin-top: 24rpx; }
