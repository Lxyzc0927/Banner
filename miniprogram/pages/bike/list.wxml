<view class="toolbar">
  <view class="search">
    <image class="icon-s" src="/assets/icons/magnifying-glass-bold-5a5a57.svg" aria-hidden="true" />
    <input class="search-input" value="{{keyword}}" placeholder="搜车型名称或类别" placeholder-class="ph" confirm-type="search" bindinput="onInput" bindconfirm="onSearch" />
    <view wx:if="{{keyword}}" class="search-clear" bindtap="onClear" aria-role="button" aria-label="清空搜索">
      <image class="icon-s" src="/assets/icons/x-bold-5a5a57.svg" aria-hidden="true" />
    </view>
  </view>
  <scroll-view class="chips" scroll-x enable-flex show-scrollbar="{{false}}">
    <view wx:for="{{ccOptions}}" wx:key="value"
      class="chip {{item.value ? 'chip-plate' : 'chip-all'}} {{cc === item.value ? 'on chip-' + item.color : ''}}"
      hover-class="pressed" data-value="{{item.value}}" bindtap="onCc"
      aria-role="button" aria-label="{{item.value ? item.value + 'cc' : '全部排量'}}" aria-selected="{{cc === item.value}}">
      <text class="{{item.value ? 'num' : ''}}">{{item.label}}</text>
    </view>
  </scroll-view>
  <view class="sortbar">
    <view class="segments" aria-role="tablist" aria-label="排序">
      <view wx:for="{{sortOptions}}" wx:key="value" class="seg {{sort === item.value ? 'on' : ''}}" data-value="{{item.value}}" bindtap="onSort"
        aria-role="tab" aria-selected="{{sort === item.value}}">{{item.label}}</view>
    </view>
    <view class="filter-btn {{priceText ? 'on' : ''}}" hover-class="pressed" bindtap="openPrice" aria-role="button" aria-label="{{priceText ? '价格区间 ' + priceText : '按价格筛选'}}">
      <text>价格</text>
      <image class="icon-s" src="{{priceText ? '/assets/icons/caret-down-bold-ffffff.svg' : '/assets/icons/caret-down-bold-000000.svg'}}" aria-hidden="true" />
    </view>
    <view class="filter-btn {{tagCount ? 'on' : ''}}" hover-class="pressed" bindtap="openTags" aria-role="button" aria-label="{{tagCount ? '已选 ' + tagCount + ' 个标签' : '按标签筛选'}}">
      <text>标签</text>
      <text wx:if="{{tagCount}}" class="num badge">{{tagCount}}</text>
      <image wx:else class="icon-s" src="/assets/icons/caret-down-bold-000000.svg" aria-hidden="true" />
    </view>
  </view>
  <scroll-view wx:if="{{pills.length}}" class="pills" scroll-x enable-flex show-scrollbar="{{false}}">
    <view wx:for="{{pills}}" wx:key="label" class="pill" hover-class="pressed" data-key="{{item.key}}" data-value="{{item.value}}" bindtap="onRemovePill"
      aria-role="button" aria-label="去掉 {{item.label}}">
      <text>{{item.label}}</text>
      <image class="icon-s" src="/assets/icons/x-bold-ffffff.svg" aria-hidden="true" />
    </view>
    <view class="pill-clear" bindtap="onClearFilter">全部清除</view>
  </scroll-view>
</view>

<view class="wrap">
  <view wx:if="{{!list.length && loading}}" aria-busy="true">
    <view class="skeleton sk-row" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this"></view>
  </view>
  <bike-card wx:for="{{list}}" wx:key="id" bike="{{item}}" />
</view>

<empty wx:if="{{empty && !loading && !error}}" text="没有符合条件的车型" action-text="{{keyword || cc || pills.length ? '清除筛选' : ''}}" bind:action="onClearFilter" />

<view class="list-foot">
  <text wx:if="{{loading && list.length}}">加载中…</text>
  <text wx:elif="{{error}}" class="link" bindtap="onRetry">没加载出来，点这里重试</text>
  <text wx:elif="{{finished && !empty}}">共 {{total}} 款，已经到底了</text>
</view>

<block wx:if="{{priceSheet}}">
  <view class="mask" bindtap="closePrice" catchtouchmove="noop"></view>
  <view class="sheet" catchtouchmove="noop" aria-role="dialog" aria-label="按价格筛选">
    <view class="sheet-head">
      <text class="sheet-title">按价格筛选</text>
      <view class="close" bindtap="closePrice" aria-role="button" aria-label="关闭">
        <image class="icon-s" src="/assets/icons/x-bold-5a5a57.svg" aria-hidden="true" />
      </view>
    </view>
    <view class="presets">
      <view wx:for="{{pricePresets}}" wx:key="key"
        class="preset {{(priceText === item.label) || (item.key === 'all' && !priceText) ? 'on' : ''}}"
        hover-class="pressed" data-key="{{item.key}}" bindtap="onPreset">{{item.label}}</view>
    </view>
    <view class="custom-label">自定义区间（元）</view>
    <view class="custom">
      <input class="price-input num {{draft.error ? 'invalid' : ''}}" type="number" value="{{draft.min}}" placeholder="最低价" placeholder-class="ph" maxlength="7" bindinput="onDraftMin" />
      <view class="dash"></view>
      <input class="price-input num {{draft.error ? 'invalid' : ''}}" type="number" value="{{draft.max}}" placeholder="最高价" placeholder-class="ph" maxlength="7" bindinput="onDraftMax" />
    </view>
    <text wx:if="{{draft.error}}" class="field-error">{{draft.error}}</text>
    <button class="btn btn-primary btn-block confirm" bindtap="onPriceConfirm">按这个区间筛选</button>
  </view>
</block>

<block wx:if="{{tagSheet}}">
  <view class="mask" bindtap="closeTags" catchtouchmove="noop"></view>
  <view class="sheet tag-sheet" aria-role="dialog" aria-label="按标签筛选">
    <view class="sheet-head">
      <text class="sheet-title">按标签筛选</text>
      <view class="close" bindtap="closeTags" aria-role="button" aria-label="关闭">
        <image class="icon-s" src="/assets/icons/x-bold-5a5a57.svg" aria-hidden="true" />
      </view>
    </view>
    <scroll-view class="tag-body" scroll-y>
      <view class="group-label">类别</view>
      <view class="presets">
        <view wx:for="{{tagView.categories}}" wx:key="value" class="preset {{item.on ? 'on' : ''}}" hover-class="pressed"
          data-type="category" data-value="{{item.value}}" bindtap="onDraftTag" aria-role="radio" aria-checked="{{item.on}}">{{item.value}}</view>
      </view>
      <view class="group-label">档位</view>
      <view class="presets">
        <view wx:for="{{tagView.tiers}}" wx:key="value" class="preset tier-opt {{item.on ? 'on tier-' + item.value : ''}}" hover-class="pressed"
          data-type="tier" data-value="{{item.value}}" bindtap="onDraftTag" aria-role="radio" aria-checked="{{item.on}}">{{item.label}}</view>
      </view>
      <view class="group-label">特点<text class="group-hint">可多选，需同时满足</text></view>
      <view class="presets">
        <view wx:for="{{tagView.tags}}" wx:key="value" class="preset {{item.on ? 'on' : ''}}" hover-class="pressed"
          data-type="tags" data-value="{{item.value}}" bindtap="onDraftTag" aria-role="checkbox" aria-checked="{{item.on}}">{{item.value}}</view>
      </view>
    </scroll-view>
    <view class="sheet-actions">
      <button class="btn btn-ghost reset" bindtap="resetTags">重置</button>
      <button class="btn btn-primary grow" disabled="{{previewTotal === 0}}" bindtap="applyTags">{{previewTotal < 0 ? '查看车型' : previewTotal === 0 ? '没有符合的车型' : '查看 ' + previewTotal + ' 款车型'}}</button>
    </view>
  </view>
</block>
