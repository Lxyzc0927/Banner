<view class="wrap header">
  <block wx:if="{{user}}">
    <image wx:if="{{user.avatar}}" class="avatar" src="{{user.avatar}}" mode="aspectFill" />
    <view wx:else class="plate plate-white avatar-plate" aria-hidden="true">骑</view>
    <view class="who">
      <view class="nick">{{user.nickname}}</view>
      <view class="phone {{user.phone ? 'num' : ''}}">{{user.phone || '还没绑定手机号'}}</view>
    </view>
  </block>
  <block wx:else>
    <view class="plate plate-white avatar-plate" aria-hidden="true">
      <image class="icon" src="/assets/icons/user-bold-000000.svg" />
    </view>
    <view class="who">
      <view class="nick">还没登录</view>
      <view class="phone">登录后可以收藏车型、报名活动</view>
    </view>
    <button class="btn btn-primary btn-small" bindtap="onLogin">登录</button>
  </block>
</view>

<view wx:if="{{user && !user.phone}}" class="wrap">
  <view class="bind">
    <text class="bind-text">绑定手机号后，报名活动不用再填</text>
    <button class="btn btn-ghost btn-small" open-type="getPhoneNumber" bindgetphonenumber="onPhone">绑定</button>
  </view>
</view>

<view class="wrap menu">
  <view class="menu-item" hover-class="pressed" data-url="/pages/mine/favorites" data-auth="{{true}}" bindtap="onMenu">
    <image class="icon" src="/assets/icons/heart-bold-000000.svg" aria-hidden="true" />
    <text class="menu-text">我的收藏</text>
    <image class="icon-s" src="/assets/icons/caret-right-bold-5a5a57.svg" aria-hidden="true" />
  </view>
  <view class="menu-item" hover-class="pressed" data-url="/pages/mine/signups" data-auth="{{true}}" bindtap="onMenu">
    <image class="icon" src="/assets/icons/flag-checkered-bold-000000.svg" aria-hidden="true" />
    <text class="menu-text">我的报名</text>
    <image class="icon-s" src="/assets/icons/caret-right-bold-5a5a57.svg" aria-hidden="true" />
  </view>
  <view class="menu-item" hover-class="pressed" data-url="/pages/chat/index" bindtap="onMenu">
    <image class="icon" src="/assets/icons/chat-circle-text-bold-000000.svg" aria-hidden="true" />
    <text class="menu-text">智能客服</text>
    <image class="icon-s" src="/assets/icons/caret-right-bold-5a5a57.svg" aria-hidden="true" />
  </view>
</view>

<view wx:if="{{user}}" class="wrap">
  <view class="logout" hover-class="pressed" bindtap="onLogout">退出登录</view>
</view>
