.list { padding: 20rpx 24rpx 0; }
.item { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.title { font-size: 30rpx; font-weight: 600; }
