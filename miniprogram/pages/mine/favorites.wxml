<empty wx:if="{{!loggedIn}}" text="登录后查看收藏的车型" action-text="去登录" bind:action="onLogin" />

<block wx:else>
  <view class="grid">
    <bike-card wx:for="{{list}}" wx:key="id" bike="{{item}}" />
  </view>

  <empty wx:if="{{empty && !loading && !error}}" text="还没有收藏车型" action-text="去逛逛" bind:action="goBikes" />

  <view class="list-foot">
    <text wx:if="{{loading}}">加载中…</text>
    <text wx:elif="{{error}}" bindtap="onRetry">加载失败，点击重试</text>
    <text wx:elif="{{finished && !empty}}">共 {{total}} 款</text>
  </view>
</block>
