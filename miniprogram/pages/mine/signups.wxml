<empty wx:if="{{!loggedIn}}" text="登录后才能看到报名记录" action-text="去登录" bind:action="onLogin" />

<block wx:else>
  <view class="wrap">
    <view wx:if="{{!list.length && loading}}" aria-busy="true">
      <view class="skeleton sk-row" wx:for="{{[1, 2, 3]}}" wx:key="*this"></view>
    </view>

    <view wx:for="{{list}}" wx:key="id" class="row {{item.status === '已结束' ? 'ended' : ''}}" hover-class="pressed" data-id="{{item.activityId}}" bindtap="open">
      <view class="plate date {{item.status === '已结束' ? 'plate-white' : 'plate-yellow'}}">
        <text class="day">{{item.day}}</text>
        <text class="month">{{item.month}}月</text>
      </view>
      <view class="info">
        <view class="title-row">
          <text class="title">{{item.title}}</text>
          <text class="state {{item.status === '已结束' ? 'state-ended' : 'state-signed'}}">{{item.status === '已结束' ? '已结束' : '待参加'}}</text>
        </view>
        <view class="meta"><text class="num">{{item.time}}</text><text class="place">{{item.place}}</text></view>
        <view class="meta">报名人 {{item.name}}<text class="num phone">{{item.phone}}</text></view>
        <view class="meta light">报名于 <text class="num">{{item.createdText}}</text></view>
      </view>
    </view>
  </view>

  <empty wx:if="{{empty && !loading && !error}}" text="还没有报名活动" action-text="看看近期活动" bind:action="goActivities" />

  <view class="list-foot">
    <text wx:if="{{loading && list.length}}">加载中…</text>
    <text wx:elif="{{error}}" class="link" bindtap="onRetry">没加载出来，点这里重试</text>
    <text wx:elif="{{finished && !empty}}">已经到底了</text>
  </view>
</block>
