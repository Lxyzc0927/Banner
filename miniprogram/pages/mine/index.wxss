.header { display: flex; align-items: center; padding: 60rpx 40rpx 80rpx; background: #1f2430; color: #fff; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; flex-shrink: 0; }
.avatar-ph { background: #e8541e; display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 700; }
.who { margin-left: 28rpx; flex: 1; }
.nick { font-size: 36rpx; font-weight: 600; }
.phone { font-size: 24rpx; opacity: .7; margin-top: 10rpx; }

.bind { display: flex; justify-content: space-between; align-items: center; margin: -40rpx 24rpx 0; padding: 24rpx 28rpx; border-radius: 16rpx; background: #fdeee7; color: #b5401a; font-size: 26rpx; position: relative; z-index: 2; }
.bind-btn { margin: 0; background: #e8541e; color: #fff; border-radius: 30rpx; font-size: 24rpx; }

.menu { background: #fff; margin: 30rpx 24rpx 0; border-radius: 16rpx; }
.menu-item { display: flex; align-items: center; padding: 32rpx 28rpx; border-bottom: 2rpx solid #f0f1f3; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { width: 48rpx; color: #e8541e; }
.menu-text { flex: 1; font-size: 28rpx; }
.arrow { color: #ccc; font-size: 36rpx; }

.logout { margin: 40rpx 24rpx; padding: 28rpx; text-align: center; background: #fff; border-radius: 16rpx; color: #a32d2d; font-size: 28rpx; }
