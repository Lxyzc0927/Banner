.header { display: flex; align-items: center; gap: 28rpx; padding-top: 48rpx; padding-bottom: 40rpx; }
.avatar { width: 128rpx; height: 128rpx; border-radius: 24rpx; flex-shrink: 0; }
.avatar-plate { width: 128rpx; height: 128rpx; font-family: -apple-system, "PingFang SC", sans-serif; font-size: 56rpx; font-weight: 800; }
.who { flex: 1; min-width: 0; }
.nick { font-size: 40rpx; font-weight: 800; }
.phone { font-size: 28rpx; color: var(--ink-2); margin-top: 6rpx; }
.phone.num { font-size: 34rpx; color: var(--ink); }

.bind { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 28rpx; border-radius: 16rpx; background: var(--paper-2); }
.bind-text { flex: 1; font-size: 28rpx; }

.menu { margin-top: 24rpx; border-top: 1px solid var(--line); }
.menu-item { display: flex; align-items: center; gap: 24rpx; min-height: 112rpx; border-bottom: 1px solid var(--line); }
.menu-item.pressed { background: var(--paper-2); }
.menu-text { flex: 1; font-size: 32rpx; }

.logout { margin-top: 64rpx; height: 96rpx; line-height: 96rpx; text-align: center; border: 2rpx solid var(--line); border-radius: 16rpx; color: var(--ink); font-size: 30rpx; }
.logout.pressed { background: var(--paper-2); }
