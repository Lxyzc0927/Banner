/*
 * XX 摩托 · 越野号码牌
 * 白底黑字；号码牌是唯一的色块：白牌 150/250、黄牌 300/400、红牌 500。
 * 黄色另外只给"当前选中"和"报名中"。分隔一律 1 物理像素细线。
 */
@font-face {
  font-family: "Plate";
  src: url("data:font/woff;base64,") format("woff");
  font-weight: 900;
  font-style: normal;
}

page {
  --ink: #000000;
  --ink-2: #5a5a57;
  --ink-3: #8c8c88;
  --paper: #ffffff;
  --paper-2: #f4f4f2;
  --line: #d9d9d6;
  --yellow: #ffd400;
  --red: #e10600;
  --plate-font: "Plate", "DIN Alternate", "Helvetica Neue", Arial, sans-serif;

  background: var(--paper);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
}

.num { font-family: var(--plate-font); font-weight: 900; font-variant-numeric: tabular-nums; letter-spacing: 0; }
.muted { color: var(--ink-2); }

/* ---------- 号码牌 ---------- */
.plate {
  display: inline-flex; align-items: center; justify-content: center;
  border: 6rpx solid var(--ink); border-radius: 20rpx;
  background: var(--paper); color: var(--ink);
  font-family: var(--plate-font); font-weight: 900; line-height: 1;
  font-variant-numeric: tabular-nums; flex-shrink: 0;
  transition: transform 120ms ease-out;
}
.plate-white { background: var(--paper); color: var(--ink); }
.plate-yellow { background: var(--yellow); color: var(--ink); }
.plate-red { background: var(--red); color: var(--paper); border-color: var(--red); }
/* 签名动作：按下时号码牌像压在车头上一样下沉 */
.pressed .plate, .plate.pressed { transform: translateY(4rpx); }

/* ---------- 按钮（button.xxx 提高优先级，覆盖 style v2 默认宽度） ---------- */
button::after { border: none; }
button.btn {
  display: flex; align-items: center; justify-content: center;
  width: auto; margin: 0; padding: 0 36rpx;
  height: 96rpx; line-height: 96rpx; border-radius: 16rpx;
  font-size: 30rpx; font-weight: 600;
  transition: transform 120ms ease-out, background-color 120ms ease-out;
}
button.btn-primary { background: var(--ink); color: var(--paper); }
button.btn-primary.button-hover { background: #2b2b29; transform: translateY(2rpx); }
button.btn-ghost { background: var(--paper); color: var(--ink); border: 2rpx solid var(--ink); }
button.btn-ghost.button-hover { background: var(--paper-2); transform: translateY(2rpx); }
button.btn[disabled] { background: var(--paper-2) !important; color: var(--ink-3) !important; border-color: var(--line) !important; }
button.btn-block { width: 100%; }
button.btn-small { height: 88rpx; line-height: 88rpx; padding: 0 28rpx; font-size: 26rpx; border-radius: 12rpx; }

/* ---------- 版面 ---------- */
.wrap { padding: 0 32rpx; }
.section { padding: 48rpx 32rpx 8rpx; }
.section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16rpx; }
.section-title { font-size: 36rpx; font-weight: 700; }
.section-more { display: flex; align-items: center; min-height: 88rpx; font-size: 26rpx; color: var(--ink-2); }
.rule-top { border-top: 1px solid var(--line); }

/* 状态标记：颜色之外总带文字，不只靠颜色区分 */
.state { display: inline-flex; align-items: center; height: 44rpx; padding: 0 14rpx; border-radius: 8rpx; font-size: 24rpx; font-weight: 600; flex-shrink: 0; }
.state-open { background: var(--yellow); color: var(--ink); }
.state-signed { background: var(--ink); color: var(--paper); }
.state-full { border: 2rpx solid var(--red); color: var(--red); }
.state-ended { background: var(--paper-2); color: var(--ink-2); }

.icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.icon-s { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.list-foot { padding: 40rpx 0 56rpx; text-align: center; font-size: 26rpx; color: var(--ink-2); }
.list-foot .link { display: inline-block; padding: 16rpx 24rpx; color: var(--ink); text-decoration: underline; }

/* 名额条：黑色实心，背景浅灰 */
.meter { height: 12rpx; background: var(--paper-2); border-radius: 6rpx; overflow: hidden; }
.meter-fill { height: 100%; background: var(--ink); border-radius: 6rpx; }
.meter-fill.full { background: var(--red); }

/* 骨架：加载时占位，保持版面不跳 */
.skeleton { background: var(--paper-2); border-radius: 12rpx; }

/* ---------- 底部操作栏与弹层 ---------- */
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 32rpx; background: var(--paper); border-top: 1px solid var(--line);
}
.safe { padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }
.bottom-gap { height: calc(150rpx + env(safe-area-inset-bottom)); }

.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, .5); z-index: 100; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 101;
  background: var(--paper); border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
