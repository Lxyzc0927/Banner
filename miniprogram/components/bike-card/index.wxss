:host { display: block; }
.row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1px solid var(--line); }
.row.pressed { background: var(--paper-2); }
.cover { width: 152rpx; height: 112rpx; border-radius: 20rpx; flex-shrink: 0; }
.info { flex: 1; min-width: 0; }
.name { font-size: 32rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.meta { font-size: 26rpx; color: var(--ink-2); margin-top: 4rpx; }
.dot { margin-left: 16rpx; padding-left: 16rpx; border-left: 1px solid var(--line); }
.price { font-size: 40rpx; flex-shrink: 0; }
.yen { font-size: 26rpx; font-weight: 600; margin-right: 2rpx; }
